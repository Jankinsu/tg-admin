[Unit]
Description=tg-admin Telegram management bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tgbot
Group=tgbot
WorkingDirectory=/opt/tg-admin
EnvironmentFile=/etc/tg-admin/bot.env
ExecStart=/opt/tg-admin/.venv/bin/python -m tg_admin
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
# Phase 2 runs selected root commands inside this service namespace.
# ProtectHome=true would hide /home, /root and /run/user from even the
# authenticated helper, blocking legitimate administration of those paths.
# Separate tgexec OS permissions continue to isolate ordinary commands.
# Do NOT set NoNewPrivileges=yes: Phase 1 uses sudo solely to change
# identity to the less-privileged tgexec account.
# Bot must NEVER be a member of docker or sudo groups.

[Install]
WantedBy=multi-user.target
